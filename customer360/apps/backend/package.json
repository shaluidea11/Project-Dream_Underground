{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx nest build",
    "dev": "npx nest start --watch",
    "start": "npx nest start",
    "start:prod": "npm run migration:run:prod && node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "migration:generate": "typeorm migration:generate -d src/config/data-source.ts",
    "migration:run": "ts-node -P tsconfig.json -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:run -d src/config/data-source.ts",
    "migration:run:prod": "node ../../node_modules/typeorm/cli.js migration:run -d dist/config/data-source.js",
    "migration:revert": "ts-node -P tsconfig.json -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:revert -d src/config/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/seed/run-seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph": "^1.4.2",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.57.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
